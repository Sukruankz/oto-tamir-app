rules_version = '2';

// PRD 3.5 — Çoklu Kiracılı (Multi-Tenant) Veri İzolasyonu.
service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapmis() {
      return request.auth != null;
    }

    function ayniSirket(sirketId) {
      return girisYapmis() && request.auth.token.sirketId == sirketId;
    }

    function ayniSirketAlanindan() {
      return girisYapmis() && resource.data.sirketId == request.auth.token.sirketId;
    }

    function rol() {
      return request.auth.token.rol;
    }

    // PRD 2 — Sadece Admin: personel ekleme/çıkarma, plaka düzeltme,
    // gider silme/düzenleme.
    function adminMi(sirketId) {
      return ayniSirket(sirketId) && rol() == 'admin';
    }

    function superAdminMi() {
      return girisYapmis() && request.auth.token.superadmin == true;
    }

    match /companies/{sirketId} {
      allow read: if ayniSirket(sirketId) || superAdminMi();
      allow create, delete: if superAdminMi();
      allow update: if superAdminMi() || adminMi(sirketId);

      match /users/{userId} {
        allow read: if ayniSirket(sirketId);
        allow create, update, delete: if adminMi(sirketId);
      }

      match /vehicles/{vehicleId} {
        allow read: if ayniSirket(sirketId);
        allow create: if ayniSirket(sirketId);
        allow update: if adminMi(sirketId);
        allow delete: if adminMi(sirketId);

        match /jobs/{jobId} {
          allow read: if ayniSirket(sirketId);
          allow create: if ayniSirket(sirketId);
          // İşlem düzenleme: Admin HER kaydı düzenleyebilir; Usta/Çırak
          // SADECE kendi girdiği kaydı düzenleyebilir (girenKullaniciId
          // kendi uid'siyle eşleşmeli — bkz. "Kayıtlarım" ekranı).
          // Silme her zaman sadece Admin (veri bütünlüğü).
          allow update: if adminMi(sirketId) ||
              (ayniSirket(sirketId) && resource.data.girenKullaniciId == request.auth.uid);
          allow delete: if adminMi(sirketId);
        }
      }

      match /expenses/{expenseId} {
        allow read: if ayniSirket(sirketId);
        allow create: if ayniSirket(sirketId);
        // Gider düzenleme: Admin HER kaydı düzenleyebilir; Usta/Çırak
        // SADECE kendi girdiği kaydı düzenleyebilir. Silme sadece Admin.
        allow update: if adminMi(sirketId) ||
            (ayniSirket(sirketId) && resource.data.girenKullaniciId == request.auth.uid);
        allow delete: if adminMi(sirketId);
      }

      match /summary/{monthId} {
        allow read: if ayniSirket(sirketId);
        allow write: if ayniSirket(sirketId);
      }
    }
  }
}
